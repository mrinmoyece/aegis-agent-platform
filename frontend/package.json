{
  "name": "@aegis/operator-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Secure tenant-scoped Aegis operator interface",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --coverage",
    "test:a11y": "vitest run --project accessibility",
    "e2e": "playwright test",
    "contract:generate": "node scripts/generate-contracts.mjs",
    "contract:check": "pnpm contract:generate && git diff --exit-code -- src/api/generated.ts",
    "audit": "pnpm audit --prod --audit-level high",
    "license:check": "node scripts/check-licenses.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "csp:check": "node scripts/check-csp.mjs",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --prod --out dist/operator-ui.sbom.cdx.json --sbom-type application",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:a11y && pnpm build && pnpm contract:check && pnpm license:check && pnpm bundle:check && pnpm csp:check && pnpm sbom:generate"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
