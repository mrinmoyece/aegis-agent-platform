# LOCAL DEVELOPMENT ONLY. Replace every value before using this file outside an
# isolated developer workstation. This file contains no production credentials.
AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_API_PORT=8080
AEGIS_POSTGRES_PORT=5432
AEGIS_REDIS_PORT=6379
AEGIS_KEYCLOAK_PORT=8081
AEGIS_PROMETHEUS_PORT=9090
AEGIS_GRAFANA_PORT=3000
AEGIS_OTLP_GRPC_PORT=4317
AEGIS_OTLP_HTTP_PORT=4318
AEGIS_OIDC_AUDIENCE=aegis-control-plane
AEGIS_OIDC_CLOCK_SKEW_SECONDS=30
AEGIS_REDIS_MAX_CONNECTIONS=32
AEGIS_REDIS_CONNECT_TIMEOUT_SECONDS=2
AEGIS_REDIS_SOCKET_TIMEOUT_SECONDS=5
AEGIS_WORKER_MAX_CONCURRENCY=16
AEGIS_WORKER_LEASE_SECONDS=30
AEGIS_WORKER_HEARTBEAT_SECONDS=10
AEGIS_TELEMETRY_EXPORT_TIMEOUT_SECONDS=2
AEGIS_TELEMETRY_BUFFER_CAPACITY=4096
AEGIS_TELEMETRY_SAMPLE_RATE=0.10

# Secret providers resolve only explicit references. Add local values with the
# AEGIS_SECRET_ prefix to your shell or an untracked override file when needed.
# Model provider keys are intentionally absent. The committed diagnostic uses
# only the deterministic mock. A local adapter reference may point to an
# untracked AEGIS_SECRET_OPENAI_API_KEY or AEGIS_SECRET_ANTHROPIC_API_KEY.
# Production must use an explicit vault-backed reference, verified TLS, bounded
# pools/timeouts, and audited proxy/egress; ambient SDK credentials are disabled.

# These deliberately obvious local-only values allow the tutorial stack to
# start. They are unsafe for shared, staging, or production environments.
AEGIS_POSTGRES_USER=aegis
AEGIS_POSTGRES_PASSWORD=local-dev-postgres-only
AEGIS_POSTGRES_APP_PASSWORD=local-dev-app-postgres-only
AEGIS_POSTGRES_DB=aegis
AEGIS_KEYCLOAK_ADMIN=local-admin
AEGIS_KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-only
AEGIS_GRAFANA_ADMIN_USER=local-admin
AEGIS_GRAFANA_ADMIN_PASSWORD=local-dev-grafana-only
